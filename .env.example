# ---------------------------------------------------------------------------
# Supabase
# Proje ayarlari > API bolumunden alinir. (https://supabase.com/dashboard)
# NEXT_PUBLIC_* degiskenleri tarayiciya gonderilir; sadece anon key kullanin.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"
# Supabase 2025'te bu anahtari yeniden adlandirdi. Dashboard > Connect ekrani
# artik "publishable" adini veriyor. Kod IKI ismi de kabul eder; birini doldurun:
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# OPSIYONEL - su an hicbir yerden cagrilmiyor, bos birakabilirsiniz.
# Yeni adi "secret key" (sb_secret_...). RLS'i TAMAMEN atlar; sadece sunucuda
# kullanilir, ASLA NEXT_PUBLIC_ on eki verilmez ve istemciye sizdirilmaz.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Yapay Zeka saglayicisi (OpenAI veya OpenAI-uyumlu bir endpoint)
# ---------------------------------------------------------------------------
# Bos birakirsaniz (veya yer tutucuyu silmezseniz) AI otomatik olarak mock
# moda duser - 401 hatasi almazsiniz.
OPENAI_API_KEY=""
# Opsiyonel: OpenAI uyumlu alternatif saglayici (OpenRouter, Groq, yerel LLM...)
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Soru uretimi ve degerlendirme icin kullanilacak modeller.
AI_MODEL_GENERATION="gpt-4o-mini"
AI_MODEL_GRADING="gpt-4o-mini"

# AI cagrilarini gercekten yapmadan sahte (mock) cevap dondurur.
# Hackathon demolarinda kota tuketmemek icin "true" yapabilirsiniz.
AI_MOCK_MODE="false"

# ---------------------------------------------------------------------------
# Uygulama
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Yerel gelistirme kolayliklari
#
# Bunlar YALNIZCA NODE_ENV !== "production" iken calisir; `next build` ile
# alinan bir surumde acik birakilsalar bile devreye girmezler.
# ---------------------------------------------------------------------------

# Ust cubuga rol degistirici ekler: tek hesapla dort rolu de gezebilirsiniz.
# Yalnizca ARAYUZU etkiler; veritabani yetkileri (RLS) gercek hesabiniza gore
# calismaya devam eder.
NEXT_PUBLIC_DEV_ROLE_SWITCH="false"
