# ---------------------------------------------------------------------------
# Supabase
# Proje ayarlari > API bolumunden alinir. (https://supabase.com/dashboard)
# NEXT_PUBLIC_* degiskenleri tarayiciya gonderilir; sadece anon key kullanin.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"
# Supabase 2025'te bu anahtari yeniden adlandirdi. Dashboard > Connect ekrani
# artik "publishable" adini veriyor. Kod IKI ismi de kabul eder; birini doldurun:
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Ogrenci degerlendirme guvenligi migration'i uygulandiktan sonra ZORUNLUDUR.
# Yeni adi "secret key" (sb_secret_...). RLS'i TAMAMEN atlar; yalnizca sunucuda
# AI puanlama icin kullanilir. ASLA NEXT_PUBLIC_ on eki verilmez veya commitlenmez.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Yapay zeka
#
# ONEMLI: Burasi artik YEDEK yoldur. Anahtarin asil yeri arayuzdeki
# "Sistem > API Anahtarlari" ekranidir (/dashboard/sistem/api) - musteri kendi
# anahtarini oradan girer, sunucuyu yeniden baslatmaya gerek kalmaz. Panelde
# gecerli bir anahtar varsa asagidaki degerler YOK SAYILIR. Buradaki alanlar
# yalnizca ilk kurulum ve yerel gelistirme icin durur.
#
# TEK ALAN, TUM SAGLAYICILAR: anahtari asagiya yazin, saglayici onekinden
# otomatik secilir.
#   - "AIza..." / "AQ."  -> Google Gemini
#   - "sk-ant-..."       -> Anthropic (Claude)
#   - "sk-or-..."        -> OpenRouter
#   - "sk-..." / "gsk_..." -> OpenAI ve OpenAI-uyumlu servisler
# Otomatik secimi ezmek icin AI_PROVIDER=openai|anthropic|google|openrouter|diger.
#
# Anahtar bos veya 20 karakterden kisa ise AI mock moda duser: gercek model
# cagrilmaz, arayuzde "simulasyon modunda" uyarisi cikar.
# ---------------------------------------------------------------------------

# --- Secenek 1: Gemini (ucretsiz katman, kart istemez) ---
# https://aistudio.google.com -> "Get API key"
# OPENAI_API_KEY="AIza..."
# AI_MODEL_GENERATION="gemini-2.5-flash"
# AI_MODEL_GRADING="gemini-2.5-flash"

# --- Secenek 2: OpenAI (odemeli) ---
# https://platform.openai.com -> API keys
# OPENAI_API_KEY="sk-..."
# AI_MODEL_GENERATION="gpt-4o-mini"
# AI_MODEL_GRADING="gpt-4o-mini"

# --- Secenek 3: Anthropic (Claude) ---
# https://console.anthropic.com -> API keys
# OPENAI_API_KEY="sk-ant-api03-..."
# AI_MODEL_GENERATION="claude-sonnet-5"
# AI_MODEL_GRADING="claude-haiku-4-5-20251001"

# --- Secenek 4: OpenRouter (tek anahtarla yuzlerce model) ---
# https://openrouter.ai/keys
# OPENAI_API_KEY="sk-or-v1-..."
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"
# AI_MODEL_GENERATION="openai/gpt-4o-mini"

# --- Secenek 5: OpenAI-uyumlu baska saglayici (Groq, yerel LLM) ---
# OPENAI_API_KEY="gsk_..."
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"
# AI_MODEL_GENERATION="llama-3.3-70b-versatile"

OPENAI_API_KEY=""
# AI_PROVIDER=""
# OPENAI_BASE_URL=""
# AI_MODEL_GENERATION=""
# AI_MODEL_GRADING=""

# AI cagrilarini hic yapmadan sahte cevap dondurur (demo sirasinda kota
# harcamamak icin). Anahtar yoksa bu deger ne olursa olsun mock calisir.
AI_MOCK_MODE="false"

# ---------------------------------------------------------------------------
# Uygulama
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:8080"

# ---------------------------------------------------------------------------
# Yerel gelistirme kolayliklari
#
# Bunlar YALNIZCA NODE_ENV !== "production" iken calisir; `next build` ile
# alinan bir surumde acik birakilsalar bile devreye girmezler.
# ---------------------------------------------------------------------------

# Ust cubuga rol degistirici ekler: tek hesapla dort rolu de gezebilirsiniz.
# Yalnizca ARAYUZU etkiler; veritabani yetkileri (RLS) gercek hesabiniza gore
# calismaya devam eder.
NEXT_PUBLIC_DEV_ROLE_SWITCH="false"
